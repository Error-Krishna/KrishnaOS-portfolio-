# Cloud platforms provide PORT automatically.
PORT=4000

# Bind to all interfaces in containers/cloud environments.
HOST=0.0.0.0

# MongoDB connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/krishnaos

# URL of the deployed frontend.
CLIENT_ORIGIN=http://localhost:5173

# Optional: enables live GitHub project-catalog sync.
# Without these, the server falls back to the static catalog.
GITHUB_OWNER=<your-github-username>
GITHUB_TOKEN=<a-github-personal-access-token-with-repo-read-access>
