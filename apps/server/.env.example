PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/krishnaos
CLIENT_ORIGIN=http://localhost:5173

# Optional: enables live GitHub project-catalog sync (see
# services/projects/project-catalog.service.ts). Without these, the
# server automatically falls back to the static catalog in
# fallback-catalog.data.ts — the app still works, it just won't reflect
# new repos until these are set.
GITHUB_OWNER=<your-github-username>
GITHUB_TOKEN=<a-github-personal-access-token-with-repo-read-access>
